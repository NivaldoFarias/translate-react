{
	"name": "translate-react",
	"version": "0.3.1",
	"contributors": [
		{
			"name": "Nivaldo Farias",
			"url": "https://github.com/NivaldoFarias"
		}
	],
	"license": "MIT",
	"homepage": "https://github.com/NivaldoFarias/translate-react",
	"description": "Drafts translation PRs for react.dev locale contributors",
	"type": "module",
	"engines": {
		"bun": ">=1.3.0"
	},
	"scripts": {
		"start": "bun src/app/main.ts",
		"dev": "bun --watch src/app/main.ts",
		"build": "bun src/app/build.ts",
		"lint": "eslint . --cache && bun run actionlint",
		"lint:fix": "eslint . --fix",
		"actionlint": "github-actionlint",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"type-check": "tsc",
		"test": "bun test",
		"ci:poll-upstream": "bun src/ci/actions/poll-upstream.ts",
		"ci:poll-gate": "bun src/ci/actions/poll-gate.ts",
		"ci:resolve-matrix": "bun src/ci/actions/resolve-matrix.ts",
		"ci:select-matrix": "bun src/ci/actions/select-matrix.ts",
		"ci:resolve-translation-targets": "bun src/ci/actions/resolve-translation-targets.ts",
		"ci:verify-changelog": "bun src/ci/actions/verify-changelog.ts",
		"ci:smoke": "bun src/ci/actions/smoke.ts",
		"ci:changelog-notes": "bun src/ci/actions/changelog-notes.ts",
		"release:prepare": "bun src/ci/actions/prepare-release.ts",
		"test:watch": "bun test --watch",
		"test:coverage": "bun test --coverage"
	},
	"dependencies": {
		"@langchain/textsplitters": "^1.0.2",
		"@octokit/request-error": "^7.1.2",
		"@octokit/rest": "^22.0.1",
		"citty": "^0.2.2",
		"cld": "^2.10.1",
		"http-status-codes": "^2.3.0",
		"js-tiktoken": "^1.0.21",
		"openai": "^7.62.0",
		"p-queue": "^10.0.0",
		"p-retry": "^8.0.0",
		"pino": "^10.4.0",
		"pretty-bytes": "^7.2.0",
		"remark-gfm": "^4.0.1",
		"remark-mdx": "^3.1.1",
		"remark-parse": "^11.0.0",
		"typescript": "6.0.3",
		"unified": "^11.0.5",
		"unist-util-position": "^5.0.0",
		"unist-util-visit-parents": "^6.1.0",
		"yaml": "^2.9.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@mdx-js/mdx": "^3.1.1",
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/bun": "^1.4.5",
		"@types/eslint": "^9.6.1",
		"@types/mdast": "^4.0.4",
		"@types/node": "^26.6.6",
		"@typescript-eslint/eslint-plugin": "^8.73.0",
		"@typescript-eslint/parser": "^8.73.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-jsdoc": "^65.5.0",
		"eslint-plugin-yml": "^3.10.0",
		"github-actionlint": "^1.7.12",
		"globals": "^17.14.0",
		"jiti": "^2.6.1",
		"mdast-util-to-markdown": "^2.2.4",
		"pino-pretty": "^13.2.0",
		"prettier": "^3.10.1",
		"type-fest": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"unist-util-visit": "^5.2.0"
	}
}
